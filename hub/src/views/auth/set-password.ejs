<div class="card card-pad auth-card">
  <h1>Welcome, <%= user.name.split(' ')[0] %></h1>
  <p class="muted">Choose a password for <b><%= user.email %></b>.</p>
  <% if (error) { %><div class="flash flash-error" role="alert"><%- h.icon('alert') %><span><%= error %></span></div><% } %>
  <form method="post" action="/set-password/<%= token %>">
    <%- include('../partials/csrf') %>
    <input type="email" name="email" value="<%= user.email %>" autocomplete="username" hidden>
    <div class="field">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required autofocus>
      <div class="hint">At least 8 characters.</div>
    </div>
    <div class="field">
      <label for="confirm">Confirm password</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required>
    </div>
    <button class="btn btn-block btn-lg" type="submit">Save and continue</button>
  </form>
</div>
