<div class="crumbs"><a href="/portal/tickets">Support</a> / #<%= ticket.id %></div>
<div class="page-head">
  <div><h1><%= ticket.subject %></h1><div class="sub">#<%= ticket.id %> · opened <%= h.dateTime(ticket.created_at) %></div></div>
  <div class="actions"><%- h.badge(ticket.status, ticket.status === 'awaiting_client' ? 'Your reply needed' : ticket.status === 'open' ? 'With our team' : null) %></div>
</div>
<div class="thread" style="max-width:820px">
  <% messages.forEach(function (m) { const mine = m.user_role === 'client'; %>
  <div class="msg <%= mine ? 'mine' : '' %>"><div class="meta"><b><%= m.user_name || 'Haptags' %></b><%= mine ? '' : ' · Haptags team' %> · <%= h.dateTime(m.created_at) %></div><div class="body"><%= m.body %></div></div>
  <% }) %>
</div>
<% if (ticket.status !== 'closed') { %>
<form method="post" action="/portal/tickets/<%= ticket.id %>/reply" class="card card-pad mt-16" style="max-width:820px">
  <%- include('../partials/csrf') %>
  <div class="field"><label for="reply">Reply</label><textarea id="reply" name="body" rows="4"></textarea></div>
  <div class="row"><button class="btn" type="submit"><%- h.icon('send', 16) %> Send reply</button><button class="btn btn-ghost" type="submit" name="close" value="1">Mark as solved & close</button></div>
</form>
<% } else { %>
<p class="muted mt-16">This request is closed. <a href="/portal/tickets/new">Open a new one</a> if you need anything else.</p>
<% } %>
