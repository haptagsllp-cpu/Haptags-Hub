<%
  const cancelled = meeting.status === 'cancelled';
  const tones = { accepted: 'green', declined: 'red', pending: 'grey' };
  const labels = { accepted: 'Going', declined: 'Not going', pending: 'No reply' };
%>
<div class="crumbs"><a href="/admin/meetings">Meetings</a> / <%= meeting.title %></div>
<div class="page-head">
  <div>
    <h1><%= meeting.title %></h1>
    <div class="sub"><%= h.date(h.ist(meeting.starts_at).date) %> · <%= h.time(meeting.starts_at) %> – <%= h.time(meeting.endsAt) %> IST · organised by <%= meeting.organizer_name || '—' %></div>
  </div>
  <div class="actions">
    <% if (cancelled) { %><span class="badge tone-red">Cancelled</span><% } else { %>
      <% if (meeting.inCall) { %><span class="badge tone-green live-badge">Live · <%= meeting.inCall %> in call</span><% } %>
      <a class="btn btn-success" href="/meet/<%= meeting.room_token %>"><%- h.icon('video', 16) %> Join meeting</a>
      <% if (canManage) { %><a class="btn btn-ghost" href="/admin/meetings/<%= meeting.id %>/edit"><%- h.icon('edit', 16) %> Edit</a><% } %>
    <% } %>
  </div>
</div>
<div class="split">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h3>Join link</h3><span class="muted"><%= meeting.allow_guests ? 'Guests wait in the lobby until admitted' : 'Team only' %></span></div>
      <div class="card-body">
        <div class="copy-field"><input type="text" id="join-url" value="<%= joinUrl %>" readonly aria-label="Join link"><button class="btn btn-ghost" type="button" data-copy="#join-url"><%- h.icon('copy', 16) %> Copy</button></div>
        <div class="kv-actions mt-16">
          <a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="https://wa.me/?text=<%= encodeURIComponent('Join “' + meeting.title + '” on ' + h.date(h.ist(meeting.starts_at).date) + ' at ' + h.time(meeting.starts_at) + ' IST: ' + joinUrl) %>"><%- h.icon('whatsapp', 15) %> Share on WhatsApp</a>
          <a class="btn btn-ghost btn-sm" href="/admin/meetings/<%= meeting.id %>/invite.ics"><%- h.icon('calendar', 15) %> Add to my calendar</a>
        </div>
      </div>
    </section>
    <% if (meeting.agenda) { %>
    <section class="card"><div class="card-head"><h3>Agenda</h3></div><div class="card-body"><div class="prose"><%- h.nl2br(meeting.agenda) %></div></div></section>
    <% } %>
    <% if (mine && !cancelled) { %>
    <section class="card card-pad row-between">
      <div><b>Are you going?</b><div class="muted small">Currently: <%= labels[mine.response] %></div></div>
      <form method="post" action="/admin/meetings/<%= meeting.id %>/rsvp" class="row">
        <%- include('../../partials/csrf') %>
        <button class="btn btn-sm <%= mine.response === 'accepted' ? 'btn-success' : 'btn-ghost' %>" name="response" value="accepted">Yes</button>
        <button class="btn btn-sm <%= mine.response === 'declined' ? 'btn-danger' : 'btn-ghost' %>" name="response" value="declined">No</button>
      </form>
    </section>
    <% } %>
  </div>
  <div class="stack">
    <section class="card">
      <div class="card-head"><h3>People</h3><span class="muted"><%= people.length + 1 %></span></div>
      <ul class="list">
        <li><span class="avatar avatar-sm"><%= h.initials(meeting.organizer_name) %></span><span class="grow"><span class="title"><%= meeting.organizer_name || '—' %></span><span class="meta">Organiser</span></span></li>
        <% people.forEach(function (p) { %>
        <li>
          <span class="avatar avatar-sm<%= p.user_id ? '' : ' avatar-guest' %>"><%= h.initials(p.user_name || p.email) %></span>
          <span class="grow"><span class="title"><%= p.user_name || p.email %></span><span class="meta"><%= p.user_id ? 'Team' : 'Guest' %></span></span>
          <% if (p.user_id) { %><span class="badge tone-<%= tones[p.response] %>"><%= labels[p.response] %></span><% } %>
        </li>
        <% }) %>
      </ul>
    </section>
    <% if (canManage && !cancelled) { %>
    <form method="post" action="/admin/meetings/<%= meeting.id %>/cancel" class="card card-pad" data-confirm="Cancel this meeting?">
      <%- include('../../partials/csrf') %>
      <label class="check small mb-8"><input type="checkbox" name="notify" value="1" checked> Email everyone that it’s cancelled</label>
      <button class="btn btn-danger btn-block" type="submit">Cancel meeting</button>
    </form>
    <% } %>
  </div>
</div>
