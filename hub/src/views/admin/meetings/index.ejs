<div class="page-head">
  <div><h1>Meetings</h1><div class="sub">Video meetings run right here in the browser. Clients join from the link, with nothing to install.</div></div>
  <div class="actions">
    <form method="post" action="/admin/meetings/now" class="inline">
      <%- include('../../partials/csrf') %>
      <button class="btn btn-ghost" type="submit"><%- h.icon('video', 16) %> Meet now</button>
    </form>
    <a class="btn" href="/admin/meetings/new"><%- h.icon('plus', 16) %> Schedule</a>
  </div>
</div>
<nav class="tabs">
  <% [['upcoming', 'My upcoming'], ['team', 'Whole team'], ['past', 'Past']].forEach(function (t) { %><a href="/admin/meetings?view=<%= t[0] %>" class="<%= view === t[0] ? 'active' : '' %>"><%= t[1] %></a><% }) %>
</nav>
<% if (!groups.length) { %>
<div class="card"><div class="empty"><%- h.icon('calendar', 30) %><b><%= view === 'past' ? 'No past meetings' : 'Nothing scheduled' %></b><%= view === 'past' ? 'Meetings you were part of show up here.' : 'Schedule a meeting, or start one now and share the link.' %></div></div>
<% } %>
<% groups.forEach(function (g) { %>
<section class="card mb-16">
  <div class="card-head"><h3><%= g.date === today ? 'Today' : h.date(g.date) %></h3><span class="muted"><%= new Date(g.date + 'T00:00:00Z').toLocaleDateString('en-IN', { weekday: 'long', timeZone: 'UTC' }) %></span></div>
  <ul class="list">
    <% g.items.forEach(function (m) { %>
    <li class="meeting-row<%= m.status === 'cancelled' ? ' cancelled' : '' %>">
      <div class="meeting-time"><b><%= h.time(m.starts_at) %></b><span><%= m.duration_min %> min</span></div>
      <div class="grow">
        <a class="title" href="/admin/meetings/<%= m.id %>"><%= m.title %></a>
        <span class="meta">Organised by <%= m.organizer_name || '—' %><%= m.status === 'cancelled' ? ' · Cancelled' : '' %></span>
      </div>
      <% if (m.inCall) { %><span class="badge tone-green live-badge">Live · <%= m.inCall %> in call</span><% } %>
      <% if (m.status === 'scheduled' && (!m.past || m.inCall)) { %><a class="btn btn-sm <%= m.soon || m.inCall ? 'btn-success' : 'btn-ghost' %>" href="/meet/<%= m.room_token %>"><%- h.icon('video', 15) %> Join</a><% } %>
    </li>
    <% }) %>
  </ul>
</section>
<% }) %>
