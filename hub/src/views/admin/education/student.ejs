<%
  const first = st.name.split(' ')[0];
  const wa = next ? h.waLink(st.phone, 'Hi ' + first + ', here is your fee invoice ' + next.number + ' for ' + (next.title || 'your program') + ': ' + h.inr(Number(next.total) - Number(next.amount_paid)) + ' due by ' + h.date(next.due_date) + '. Pay by UPI or card here: ' + next.link) : h.waLink(st.phone, 'Hi ' + first + ', ');
%>
<div class="crumbs"><a href="/admin/education">Education</a> / <a href="/admin/education/students">Students</a> / <%= st.name %></div>
<div class="page-head">
  <div>
    <h1><%= st.name %></h1>
    <div class="sub"><%= [st.program_name, st.batch, st.college].filter(Boolean).join(' · ') || 'Student' %></div>
  </div>
  <div class="actions">
    <% if (wa) { %><a class="btn btn-wa" href="<%= wa %>" target="_blank" rel="noopener"><%- h.icon('whatsapp', 16) %> <%= next ? 'Send invoice on WhatsApp' : 'WhatsApp' %></a><% } %>
    <a class="btn btn-ghost" href="/admin/education/students/<%= st.id %>/edit"><%- h.icon('edit', 16) %> Edit</a>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="label">Total fee</div><div class="value"><%= h.inr(totals.billed) %></div></div>
  <div class="stat"><div class="label">Paid</div><div class="value"><%= h.inr(totals.paid) %></div></div>
  <div class="stat"><div class="label">Balance due</div><div class="value <%= totals.due > 0 ? 'down' : totals.billed > 0 ? 'up' : 'muted' %>"><%= totals.due > 0 ? h.inr(totals.due) : totals.billed > 0 ? 'Fully paid' : 'No fee billed yet' %></div><% if (next) { %><div class="delta">Next due <%= h.date(next.due_date) %></div><% } %></div>
</div>

<div class="split">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h3>Fee invoices</h3><span class="muted"><%= invoices.length %></span></div>
      <% if (!invoices.length) { %><div class="empty">No invoices yet.</div><% } else { %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>Invoice</th><th>For</th><th>Due</th><th class="num">Amount</th><th class="num">Paid</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% invoices.forEach(function (i) { %>
          <tr>
            <td><a class="strong" href="/admin/invoices/<%= i.id %>"><%= i.number || 'Draft' %></a></td>
            <td><%= i.title || '—' %></td>
            <td class="nowrap"><%= h.date(i.due_date) %></td>
            <td class="num"><%= h.inr(i.total) %></td>
            <td class="num"><%= h.inr(i.amount_paid) %></td>
            <td><%- h.badge(i.status) %></td>
            <td class="nowrap">
              <% if (i.status !== 'draft' && i.status !== 'void') { %><button class="btn btn-ghost btn-sm" type="button" data-copy-text="<%= i.link %>" title="Copy payment link"><%- h.icon('link', 15) %></button><% } %>
              <% if (isAdmin || i.status === 'draft') { %>
              <form method="post" action="/admin/invoices/<%= i.id %>/delete" class="inline" data-confirm="Permanently delete <%= i.number || 'this draft' %><%= Number(i.amount_paid) > 0 ? ' and its payments' : '' %>? This can’t be undone.">
                <%- include('../../partials/csrf') %><input type="hidden" name="back" value="/admin/education/students/<%= st.id %>">
                <button class="btn btn-ghost btn-sm" type="submit" title="Delete invoice" aria-label="Delete <%= i.number || 'draft' %>"><%- h.icon('trash', 15) %></button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table></div>
      <% } %>
    </section>

    <section class="card">
      <div class="card-head"><h3>Payments</h3></div>
      <% if (!payments.length) { %><div class="empty">No payments yet. Record one from the invoice, or the student pays online with the link.</div><% } else { %>
      <ul class="list">
        <% payments.forEach(function (p) { %>
        <li><div class="grow"><span class="title"><%= h.inr(p.amount) %> · <%= h.method(p.method) %></span><span class="meta"><%= h.date(p.paid_on) %> · <%= p.invoice_number %><%= p.reference ? ' · ref ' + p.reference : '' %></span></div><%- h.badge(p.status) %></li>
        <% }) %>
      </ul><% } %>
    </section>

    <section class="card" id="certificates">
      <div class="card-head"><h3>Certificates</h3><span class="muted"><%= certificates.length %></span></div>
      <% if (certificates.length) { %>
      <ul class="list">
        <% certificates.forEach(function (c) { %>
        <li>
          <div class="grow">
            <span class="title"><span class="mono"><%= c.certificate_no %></span> · <%= c.programme || 'Certificate' %></span>
            <span class="meta"><%= c.issued_on ? 'Issued ' + h.date(c.issued_on) : '' %><%= c.grade ? ' · Grade ' + c.grade : '' %><%= c.duration ? ' · ' + c.duration : '' %> · <%= c.source === 'lms' ? 'from LMS' : 'uploaded' %></span>
          </div>
          <% if (c.file_id) { %><a class="btn btn-ghost btn-sm" href="/admin/education/certificates/<%= c.id %>/pdf" target="_blank" rel="noopener"><%- h.icon('download', 15) %> PDF</a><% } %>
          <% if (c.verify_url) { %><a class="btn btn-ghost btn-sm" href="<%= c.verify_url %>" target="_blank" rel="noopener" title="Public verification page"><%- h.icon('external', 15) %></a><% } %>
          <% if (isAdmin) { %><form method="post" action="/admin/education/certificates/<%= c.id %>/delete" class="inline" data-confirm="Remove <%= c.certificate_no %> from the Hub? It stays on the LMS."><%- include('../../partials/csrf') %><button class="btn btn-ghost btn-sm" type="submit" aria-label="Remove certificate"><%- h.icon('trash', 15) %></button></form><% } %>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <div class="card-body"<%- certificates.length ? ' style="border-top:1px solid var(--border)"' : '' %>>
        <% if (lmsEnabled) { %>
        <form method="post" action="/admin/education/students/<%= st.id %>/certificates" class="row mb-16">
          <%- include('../../partials/csrf') %>
          <input type="text" name="certificate_no" placeholder="LMS certificate ID, e.g. HAP-INT-001" class="mono" aria-label="LMS certificate ID" style="max-width:280px">
          <button class="btn btn-ghost btn-sm" type="submit">Fetch from LMS</button>
        </form>
        <% } %>
        <details>
          <summary class="small muted" style="cursor:pointer">Upload a certificate PDF instead…</summary>
          <form class="form-grid mt-8" data-cert-upload="/admin/education/students/<%= st.id %>/certificates">
            <div class="field"><label for="cu-no">Certificate number</label><input id="cu-no" name="certificate_no" type="text" class="mono" required></div>
            <div class="field"><label for="cu-prog">Programme</label><input id="cu-prog" name="programme" type="text" value="<%= st.program_name || '' %>"></div>
            <div class="field"><label for="cu-issued">Issued on</label><input id="cu-issued" name="issued_on" type="date"></div>
            <div class="field"><label for="cu-grade">Grade</label><input id="cu-grade" name="grade" type="text"></div>
            <div class="field full"><label for="cu-file">PDF or image</label><input id="cu-file" type="file" accept="application/pdf,image/png,image/jpeg" data-file required></div>
            <div class="full"><div class="error mb-8" data-upload-error role="alert"></div><button class="btn btn-ghost btn-sm" type="submit"><%- h.icon('upload', 15) %> Upload certificate</button></div>
          </form>
        </details>
      </div>
    </section>

    <form method="post" action="/admin/education/students/<%= st.id %>/invoice" class="card card-pad">
      <%- include('../../partials/csrf') %>
      <h3>Add another fee</h3>
      <p class="muted small mt-0">For an extension, a second module or a certificate fee. Amount is what the student pays<%= settings.gstin ? ', including GST' : '' %>.</p>
      <div class="form-grid">
        <div class="field full"><label for="inv-desc">Description</label><input id="inv-desc" name="description" type="text" placeholder="e.g. Internship extension – 1 month"></div>
        <div class="field"><label for="inv-amt">Amount (₹)</label><input id="inv-amt" name="amount" type="number" min="1" step="1"></div>
        <div class="field"><label for="inv-due">Due date</label><input id="inv-due" name="due_date" type="date"></div>
        <div class="field"><label for="inv-number">Invoice number</label><input id="inv-number" name="number" type="text" maxlength="30" class="mono" placeholder="Automatic: <%= nextNumber %>"></div>
        <div class="field"><label for="inv-date">Invoice date</label><input id="inv-date" name="issue_date" type="date"></div>
      </div>
      <div class="row"><label class="check small"><input type="checkbox" name="send_email" value="1" <%= st.email ? 'checked' : 'disabled' %>> Email it to the student</label><span style="flex:1"></span><button class="btn" type="submit">Create invoice</button></div>
    </form>
  </div>

  <div class="stack">
    <section class="card">
      <div class="card-head"><h3>Details</h3></div>
      <div class="card-body">
        <dl class="dl">
          <dt>Phone</dt><dd><%= st.phone || '—' %></dd>
          <dt>Email</dt><dd><%= st.email || '—' %></dd>
          <dt>College</dt><dd><%= st.college || '—' %></dd>
          <dt>Course</dt><dd><%= st.course || '—' %></dd>
          <dt>Program</dt><dd><%= st.program_name || '—' %></dd>
          <dt>Batch</dt><dd><%= st.batch || '—' %></dd>
          <dt>Course dates</dt><dd><%= st.start_date ? h.date(st.start_date) : '—' %><%= st.end_date ? ' – ' + h.date(st.end_date) : '' %></dd>
          <dt>State</dt><dd><%= st.state || '—' %></dd>
          <dt>Enrolled</dt><dd><%= h.dateTime(st.created_at) %></dd>
        </dl>
        <%- include('../../partials/credit', { creditClient: st }) %>
        <% if (st.notes) { %><hr><div class="prose small"><%- h.nl2br(st.notes) %></div><% } %>
      </div>
    </section>
    <% if (activities.length) { %>
    <section class="card">
      <div class="card-head"><h3>History</h3></div>
      <div class="card-body"><%- include('../../partials/timeline', { activities: activities }) %></div>
    </section>
    <% } %>
    <% if (isAdmin) { %>
    <form method="post" action="/admin/education/students/<%= st.id %>/delete" class="card card-pad" data-confirm="Delete <%= st.name %><%= invoices.length ? ' and their ' + invoices.length + ' invoice' + (invoices.length === 1 ? '' : 's') + (payments.length ? ' and ' + payments.length + ' payment' + (payments.length === 1 ? '' : 's') : '') : '' %>? This can’t be undone.">
      <%- include('../../partials/csrf') %>
      <p class="small muted mt-0">Created by mistake or a duplicate? Deleting removes this student<%= invoices.length ? ' and their invoices and payments' : '' %> permanently.</p>
      <button class="btn btn-danger btn-sm" type="submit"><%- h.icon('trash', 14) %> Delete student</button>
    </form>
    <% } %>
  </div>
</div>
