<%- include('_nav') %>
<%- include('../../partials/period', { periodBase: '/admin/education' }) %>

<div class="stats">
  <div class="stat hero-stat">
    <div class="label">Fees collected</div>
    <div class="value"><%= h.inrShort(kpi.collected) %></div>
    <div class="delta"><%= kpi.payments %> payment<%= kpi.payments === 1 ? '' : 's' %> in this period</div>
  </div>
  <div class="stat">
    <div class="label">Fees billed</div>
    <div class="value"><%= h.inrShort(kpi.billed) %></div>
    <div class="delta"><% if (kpi.collectionRate !== null) { %><b class="<%= kpi.collectionRate >= 80 ? 'up' : 'down' %>"><%= kpi.collectionRate %>%</b> collected<% } else { %>Nothing billed yet<% } %></div>
  </div>
  <div class="stat">
    <div class="label">Outstanding fees</div>
    <a class="value" href="/admin/education/students?status=due"><%= h.inrShort(kpi.outstanding) %></a>
    <div class="delta">All open student invoices</div>
  </div>
  <div class="stat">
    <div class="label">Students enrolled</div>
    <a class="value" href="/admin/education/students"><%= kpi.enrolled %></a>
    <div class="delta"><%= kpi.total %> in total<% if (kpi.perStudent) { %> · <%= h.inrShort(kpi.perStudent) %> avg fee<% } %></div>
  </div>
</div>

<div class="split">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>Student fees collected per month</h2><span class="muted">Last 12 months</span></div>
      <div class="card-body"><div class="chart-scroll"><%- chart %></div></div>
    </section>
    <section class="card">
      <div class="card-head"><h3>By program</h3><a class="small" href="/admin/education/programs">Programs →</a></div>
      <% if (!byProgram.length) { %><div class="empty"><b>No fees billed in this period</b><a href="/admin/education/students/new">Enrol a student</a> to raise the first invoice.</div><% } else { %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>Program</th><th class="num">Students</th><th class="num">Billed</th><th class="num">Collected</th><th class="num">Due</th><th>Collected</th></tr></thead>
        <tbody>
          <% byProgram.forEach(function (p) { const rate = p.billed ? Math.round(p.paid / p.billed * 100) : 0; %>
          <tr>
            <td><a class="strong" href="/admin/education/students?program=<%= p.id || '' %>"><%= p.name || 'No program' %></a></td>
            <td class="num"><%= p.students %></td>
            <td class="num"><%= h.inr(p.billed) %></td>
            <td class="num"><%= h.inr(p.paid) %></td>
            <td class="num"><%= h.inr(p.billed - p.paid) %></td>
            <td style="min-width:120px"><div class="progress<%= rate >= 100 ? ' done' : '' %>" role="img" aria-label="<%= rate %>% collected"><span style="width:<%= Math.min(100, rate) %>%"></span></div></td>
          </tr>
          <% }) %>
        </tbody>
      </table></div>
      <% } %>
    </section>
  </div>
  <div class="stack">
    <section class="card">
      <div class="card-head"><h3>Overdue fees</h3><a class="small" href="/admin/education/students?status=overdue">All →</a></div>
      <% if (!overdue.length) { %><div class="empty"><b>Nothing overdue</b>Reminders go out automatically before and after due dates.</div><% } else { %>
      <ul class="list">
        <% overdue.forEach(function (i) { const due = Number(i.total) - Number(i.amount_paid); const wa = h.waLink(i.phone, 'Hi ' + i.name.split(' ')[0] + ', a gentle reminder that your fee of ' + h.inr(due) + ' (' + i.number + ') was due on ' + h.date(i.due_date) + '. Pay here: ' + baseUrl + '/i/' + i.public_token); %>
        <li>
          <div class="grow"><a class="title" href="/admin/education/students/<%= i.student_id %>"><%= i.name %></a><span class="meta"><%= h.inr(due) %> · due <%= h.date(i.due_date) %></span></div>
          <% if (wa) { %><a class="btn btn-wa btn-sm" href="<%= wa %>" target="_blank" rel="noopener" title="Send a WhatsApp reminder"><%- h.icon('whatsapp', 16) %></a><% } %>
        </li>
        <% }) %>
      </ul><% } %>
    </section>
    <section class="card">
      <div class="card-head"><h3>Recent payments</h3></div>
      <% if (!recent.length) { %><div class="empty">No student payments yet.</div><% } else { %>
      <ul class="list">
        <% recent.forEach(function (p) { %>
        <li><div class="grow"><a class="title" href="/admin/education/students/<%= p.student_id %>"><%= p.name %></a><span class="meta"><%= h.method(p.method) %> · <%= h.date(p.paid_on) %></span></div><b><%= h.inr(p.amount) %></b></li>
        <% }) %>
      </ul><% } %>
    </section>
    <% if (byCollege.length) { %>
    <section class="card">
      <div class="card-head"><h3>Top colleges</h3></div>
      <ul class="list">
        <% byCollege.forEach(function (c) { %><li><div class="grow"><span class="title"><%= c.college %></span><span class="meta"><%= c.students %> student<%= c.students === 1 ? '' : 's' %></span></div><span><%= h.inrShort(c.billed) %></span></li><% }) %>
      </ul>
    </section>
    <% } %>
  </div>
</div>
